# PaperColor WiFi 配置示例
# 复制本文件到 SD 卡根目录，并重命名为 config.ini。
# Windows 请确认文件不是 config.ini.txt。

use_wifi=true
wifi_ssid=你的WiFi名称
wifi_pass=你的WiFi密码

# 可选：第二、第三组 WiFi
# wifi_ssid2=备用WiFi
# wifi_pass2=备用WiFi密码
# wifi_ssid3=手机热点
# wifi_pass3=手机热点密码

# 可选：智谱 Coding Plan
# zhipu_cookie=你的token

# 可选：语音转文字
# sf_api_key=你的key
